<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows cleartext http so local instrumentation servers
     (e.g. http://10.0.2.2:<port>) can be loaded in the WebView during testing.
     Release builds keep cleartext fully blocked. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
