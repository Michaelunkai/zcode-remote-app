<?xml version="1.0" encoding="utf-8"?>
<!-- Release security stance: cleartext stays fully blocked, except the phone's
     own loopback so the offline mode can load the on-device AI agent server.
     Loopback never leaves the device, so this cannot weaken LAN/Internet
     transport. Debug builds replace this file with a permissive variant. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
